# E2E tests run against an isolated Postgres schema (`test_e2e`) on the
# same Postgres container as dev. `prisma migrate deploy` (run by the
# jest globalSetup) creates the schema and its own `_prisma_migrations`
# history, so dev data in the `public` schema is never touched.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/billpay?schema=test_e2e"
PORT=3002
FRONTEND_ORIGIN=http://localhost:3000
