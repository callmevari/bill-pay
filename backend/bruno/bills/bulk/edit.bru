meta {
  name: Bulk edit
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/bills/bulk/edit
  body: json
  auth: none
}

body:json {
  {
    "ids": ["{{billId}}"],
    "fields": {
      "dueDate": "2026-09-30T00:00:00.000Z",
      "description": "Updated in bulk"
    }
  }
}

docs {
  Admin only. Applies the same field updates to every non-terminal
  bill in `ids`. Allowed fields: `dueDate`, `description`. At least
  one must be present; an empty `fields` object is rejected with 400.
  Terminal bills (PAID/REJECTED/ARCHIVED) fail per item with
  BILL_NOT_EDITABLE.
}
