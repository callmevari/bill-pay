meta {
  name: Bulk archive
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/bills/bulk/archive
  body: json
  auth: none
}

body:json {
  {
    "ids": ["{{billId}}"]
  }
}

docs {
  Admin only. Archives every supplied bill. Items that are PAID or
  already ARCHIVED fail with BILL_INVALID_TRANSITION; the rest succeed
  and apply cancel-on-archive cascades to any PENDING approval / in-
  flight payment.

  Response shape: `{ results: [{ id, ok, data? | error? }], summary }`.
  Always HTTP 200; empty / duplicate `ids` -> 400 BULK_INVALID_IDS.
  See `bills/bulk/approve.bru` for the full envelope.
}
