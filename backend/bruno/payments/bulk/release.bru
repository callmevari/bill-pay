meta {
  name: Bulk release
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/payments/bulk/release
  body: json
  auth: none
}

body:json {
  {
    "ids": ["{{paymentId}}"]
  }
}

docs {
  Admin only. Releases every supplied SCHEDULED payment (SCHEDULED ->
  INITIATED). Items not in SCHEDULED fail with
  PAYMENT_INVALID_TRANSITION.

  Response shape: `{ results: [{ id, ok, data? | error? }], summary }`.
  Always HTTP 200; empty / duplicate `ids` -> 400 BULK_INVALID_IDS.
  See `bills/bulk/approve.bru` for the full envelope.
}
