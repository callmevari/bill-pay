meta {
  name: Bulk cancel
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/payments/bulk/cancel
  body: json
  auth: none
}

body:json {
  {
    "ids": ["{{paymentId}}"]
  }
}

docs {
  Admin only. Cancels every supplied in-flight payment
  (UNSCHEDULED / SCHEDULED / INITIATED / FAILED -> CANCELED) and
  cascades each linked Bill to ARCHIVED in the same transaction.
  PAID / CANCELED items fail per item with PAYMENT_INVALID_TRANSITION.
}
