meta {
  name: Bulk mark as paid
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/payments/bulk/mark-as-paid
  body: json
  auth: none
}

body:json {
  {
    "ids": ["{{paymentId}}"]
  }
}

docs {
  Admin only. Marks every supplied UNSCHEDULED / SCHEDULED / INITIATED
  payment as PAID and cascades the linked Bill to PAID
  (APPROVED -> PAID from UNSCHEDULED, SCHEDULED -> PAID otherwise).
  Items in PAID / FAILED / CANCELED fail per item with
  PAYMENT_INVALID_TRANSITION.

  Response shape: `{ results: [{ id, ok, data? | error? }], summary }`.
  Always HTTP 200; empty / duplicate `ids` -> 400 BULK_INVALID_IDS.
  See `bills/bulk/approve.bru` for the full envelope.
}
