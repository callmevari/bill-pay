# Caddy configuration for the production stack.
#
# Substitution: every `{$VAR}` token is replaced at Caddy config-load
# time from the container environment. The `caddy` service in
# `docker-compose.prod.yml` passes the values through from the project's
# `.env` file, so the Caddyfile itself stays repo-safe and reusable
# across deployments.
#
# Routes:
#   https://{$DOMAIN}/api/*  -> backend:3001   (Nest API)
#   https://{$DOMAIN}/docs*  -> backend:3001   (Swagger UI — mounted on /docs by main.ts)
#   https://{$DOMAIN}/*      -> frontend:3000  (Next.js standalone)
#   https://{$STUDIO_SUBDOMAIN}/ -> prisma-studio:5555 (open — local review tool, do not leave running long-term)

{
	email {$ADMIN_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3001
	}

	# Swagger UI lives on the backend at `/docs` (see `backend/src/main.ts`
	# — `SwaggerModule.setup('docs', app, document)`). Without this
	# block, the catch-all below would route the request to the Next
	# frontend, which returns its 404 page instead of the API spec.
	handle /docs* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
		level INFO
	}
}

{$STUDIO_SUBDOMAIN} {
	encode zstd gzip

	reverse_proxy prisma-studio:5555

	log {
		output stdout
		format console
		level INFO
	}
}
