# Production env vars consumed by `docker-compose.prod.yml` and the
# Caddyfile. Copy to `.env` on the production host, fill the values, and
# keep the file off git (.gitignore already excludes `.env`).
#
# Generate STUDIO_PASSWORD_HASH with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<the-password>'
#
# Generate POSTGRES_PASSWORD with:
#   openssl rand -base64 32

# Public hostname for the app (frontend at root, API under /api/*).
DOMAIN=billpay.example.com

# Public hostname for Prisma Studio (basic-auth gated).
STUDIO_SUBDOMAIN=studio.billpay.example.com

# Used by Caddy to register with Let's Encrypt for renewal notifications.
ADMIN_EMAIL=you@example.com

# Basic-auth credentials for Prisma Studio.
STUDIO_USER=reviewer
STUDIO_PASSWORD_HASH=$2a$14$replace-me-with-the-bcrypt-hash

# Postgres credentials. Postgres listens only on the internal Docker
# network in production, but the password should still be strong because
# the volume on disk is readable by anyone with shell access.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-with-a-strong-secret
POSTGRES_DB=billpay
