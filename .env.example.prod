# Production env vars consumed by `docker-compose.prod.yml` and the
# Caddyfile. Copy to `.env` on the production host, fill the values,
# and keep the file off git (.gitignore already excludes `.env`).
#
# The `.prod` suffix is intentional: every variable below is
# production-specific (public domain, Let's Encrypt email, Postgres
# credentials baked into the host volume). Local dev does NOT consume
# this file — `docker compose up` auto-loads `docker-compose.override.yml`
# with sensible defaults. The per-package env templates for the local
# workflow live at `backend/.env.example` and `frontend/.env.example`.
#
# Generate POSTGRES_PASSWORD with:
#   openssl rand -base64 32

# Public hostname for the app (frontend at root, API under /api/*).
DOMAIN=billpay.example.com

# Public hostname for Prisma Studio.
STUDIO_SUBDOMAIN=studio.billpay.example.com

# Used by Caddy to register with Let's Encrypt for renewal notifications.
ADMIN_EMAIL=you@example.com

# Postgres credentials. Postgres listens only on the internal Docker
# network in production, but the password should still be strong because
# the volume on disk is readable by anyone with shell access.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-with-a-strong-secret
POSTGRES_DB=billpay
